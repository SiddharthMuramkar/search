{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run alembic *)",
      "Bash(uv sync *)",
      "Bash(uv add *)",
      "Bash(docker compose up *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git worktree *)",
      "Bash(git rebase *)",
      "Bash(git push -u origin step-*)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)"
    ],
    "ask": [
      "Bash(docker compose down *)",
      "Bash(uv run alembic downgrade *)"
    ],
    "deny": [
      "Edit(./.env)",
      "Bash(git push*main*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_migrations.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr_gate.sh\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_python.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
