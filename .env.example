# Copy this file to .env and fill it in. Never commit .env.

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=<your-key>
# Model for all three architectures. The default is set in milestone M3 after test calls.
LLM_MODEL=
# Judge model. Use a different model family than LLM_MODEL.
JUDGE_MODEL=

# Tavily web search (https://app.tavily.com), free tier: 1,000 searches each month
TAVILY_API_KEY=<your-key>

# PostgreSQL from docker-compose.yml
DATABASE_URL=postgresql+asyncpg://research:research@localhost:5432/research

# Traces to the local Jaeger container (OTLP over HTTP). Leave empty to turn the exporter off.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=deep-research-api
